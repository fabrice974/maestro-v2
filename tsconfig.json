{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["passerelle/**/*.ts", "packages/**/*.ts", "apps/**/*.ts", "outils/**/*.ts"],
  "exclude": ["**/node_modules", "apps/debourse-dotnet"]
}
