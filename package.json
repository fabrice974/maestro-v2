{
  "name": "maestro-v2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "passerelle",
    "outils"
  ],
  "scripts": {
    "deployer": "tsx outils/src/deployer.ts",
    "passerelle": "tsx passerelle/src/main.ts",
    "ecosysteme": "tsx outils/src/ecosysteme.ts",
    "bot": "tsx outils/src/bot-demo.ts",
    "impact": "tsx outils/src/impact.ts",
    "scenario": "tsx outils/src/scenario.ts",
    "audit:verifier": "tsx outils/src/audit-verifier.ts",
    "audit:exporter": "tsx outils/src/audit-exporter.ts",
    "generer:modeles": "tsx outils/src/generer-modeles.ts",
    "incidents": "tsx outils/src/incidents.ts",
    "verifier:cluster": "tsx outils/src/verifier-cluster.ts",
    "annuler": "tsx outils/src/annuler.ts",
    "test:ui": "tsx outils/src/test-ui.ts",
    "smoke:sharepoint": "tsx outils/src/smoke-sharepoint.ts",
