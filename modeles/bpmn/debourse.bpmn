        <di:waypoint x="2375" y="70" />
        <di:waypoint x="2457" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_23_di" bpmnElement="Flux_23">
        <di:waypoint x="2650" y="70" />
        <di:waypoint x="2725" y="70" />
      </bpmndi:BPMNEdge>
