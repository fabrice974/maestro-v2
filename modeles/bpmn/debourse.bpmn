<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_debourse" targetNamespace="http://maestro.poc/bpmn" exporter="maestro-generateur" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="debourse" name="Déboursé" isExecutable="true">
    <bpmn:documentation>Orchestration fortement auditée : conditions préalables, KYC, instruction, quatre yeux, conformité, paiement.</bpmn:documentation>
    <bpmn:startEvent id="debut" name="Déboursé demandé">
      <bpmn:outgoing>Flux_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="demande" name="Demande de déboursé">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;debourse.demande&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="demande" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_1</bpmn:incoming>
      <bpmn:outgoing>Flux_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="fourche" name="">
      <bpmn:incoming>Flux_2</bpmn:incoming>
      <bpmn:outgoing>Flux_3</bpmn:outgoing>
      <bpmn:outgoing>Flux_4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="cp" name="Vérifier les conditions préalables">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;debourse.conditions-prealables&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="conditionsPrealables" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_3</bpmn:incoming>
      <bpmn:outgoing>Flux_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="kyc" name="Contrôle KYC / LCB-FT">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;debourse.kyc&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="kyc" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_4</bpmn:incoming>
      <bpmn:outgoing>Flux_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:parallelGateway id="jonction" name="">
      <bpmn:incoming>Flux_5</bpmn:incoming>
      <bpmn:incoming>Flux_6</bpmn:incoming>
      <bpmn:outgoing>Flux_7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="gw-kyc" name="KYC conforme ?">
      <bpmn:incoming>Flux_7</bpmn:incoming>
      <bpmn:outgoing>Flux_8</bpmn:outgoing>
      <bpmn:outgoing>Flux_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="instruction" name="Préparer l&#39;instruction de paiement">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;debourse.preparer-instruction&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="instruction" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_8</bpmn:incoming>
      <bpmn:outgoing>Flux_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="regle-controles" name="Déterminer les contrôles requis">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="controles-debourse" resultVariable="conformiteRequise" />
        <zeebe:ioMapping>
          <zeebe:input source="=demande.champs.montantTirage" target="montantTirage" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="regle" value="controles-debourse" />
          <zeebe:header key="variable" value="conformiteRequise" />
        </zeebe:taskHeaders>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" retries="3" type="regle.consigner" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_10</bpmn:incoming>
      <bpmn:outgoing>Flux_11</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="approuver" name="Approuver le déboursé (quatre yeux)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;debourse.approuver&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="approbation" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_11</bpmn:incoming>
      <bpmn:outgoing>Flux_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-approuve" name="Approuvé ?">
      <bpmn:incoming>Flux_12</bpmn:incoming>
      <bpmn:outgoing>Flux_13</bpmn:outgoing>
      <bpmn:outgoing>Flux_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw-conformite" name="Conformité requise ?">
      <bpmn:incoming>Flux_13</bpmn:incoming>
      <bpmn:outgoing>Flux_15</bpmn:outgoing>
      <bpmn:outgoing>Flux_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="conformite" name="Approbation conformité">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;debourse.approuver-conformite&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="approbationConformite" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_15</bpmn:incoming>
      <bpmn:outgoing>Flux_17</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-conformite-ok" name="Approuvé ?">
      <bpmn:incoming>Flux_17</bpmn:incoming>
      <bpmn:outgoing>Flux_18</bpmn:outgoing>
      <bpmn:outgoing>Flux_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="fusion-paiement" name="">
      <bpmn:incoming>Flux_16</bpmn:incoming>
      <bpmn:incoming>Flux_18</bpmn:incoming>
      <bpmn:outgoing>Flux_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="payer" name="Exécuter le paiement (simulé)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="debourse.executer-paiement" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_20</bpmn:incoming>
      <bpmn:outgoing>Flux_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="marquer-debourse" name="Déboursé effectué">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;debourse&#34;" resultVariable="issueDebourse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_21</bpmn:incoming>
      <bpmn:outgoing>Flux_22</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="fin-ok" name="Fonds déboursés">
      <bpmn:incoming>Flux_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="fusion-refus" name="">
      <bpmn:incoming>Flux_9</bpmn:incoming>
      <bpmn:incoming>Flux_14</bpmn:incoming>
      <bpmn:incoming>Flux_19</bpmn:incoming>
      <bpmn:outgoing>Flux_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="marquer-refus" name="Déboursé refusé">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;refuse&#34;" resultVariable="issueDebourse" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_23</bpmn:incoming>
      <bpmn:outgoing>Flux_24</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="fin-refus" name="Déboursé refusé">
      <bpmn:incoming>Flux_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1" sourceRef="debut" targetRef="demande" />
    <bpmn:sequenceFlow id="Flux_2" sourceRef="demande" targetRef="fourche" />
    <bpmn:sequenceFlow id="Flux_3" sourceRef="fourche" targetRef="cp" />
    <bpmn:sequenceFlow id="Flux_4" sourceRef="fourche" targetRef="kyc" />
    <bpmn:sequenceFlow id="Flux_5" sourceRef="cp" targetRef="jonction" />
    <bpmn:sequenceFlow id="Flux_6" sourceRef="kyc" targetRef="jonction" />
    <bpmn:sequenceFlow id="Flux_7" sourceRef="jonction" targetRef="gw-kyc" />
    <bpmn:sequenceFlow id="Flux_8" name="conforme" sourceRef="gw-kyc" targetRef="instruction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kyc.decision = "conforme"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_9" name="non conforme" sourceRef="gw-kyc" targetRef="fusion-refus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=kyc.decision != "conforme"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_10" sourceRef="instruction" targetRef="regle-controles" />
    <bpmn:sequenceFlow id="Flux_11" sourceRef="regle-controles" targetRef="approuver" />
    <bpmn:sequenceFlow id="Flux_12" sourceRef="approuver" targetRef="gw-approuve" />
    <bpmn:sequenceFlow id="Flux_13" name="approuvé" sourceRef="gw-approuve" targetRef="gw-conformite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbation.decision = "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_14" name="refusé" sourceRef="gw-approuve" targetRef="fusion-refus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbation.decision != "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_15" name="oui" sourceRef="gw-conformite" targetRef="conformite">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conformiteRequise = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_16" name="non" sourceRef="gw-conformite" targetRef="fusion-paiement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conformiteRequise != true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_17" sourceRef="conformite" targetRef="gw-conformite-ok" />
    <bpmn:sequenceFlow id="Flux_18" name="approuvé" sourceRef="gw-conformite-ok" targetRef="fusion-paiement">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbationConformite.decision = "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_19" name="refusé" sourceRef="gw-conformite-ok" targetRef="fusion-refus">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbationConformite.decision != "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_20" sourceRef="fusion-paiement" targetRef="payer" />
    <bpmn:sequenceFlow id="Flux_21" sourceRef="payer" targetRef="marquer-debourse" />
    <bpmn:sequenceFlow id="Flux_22" sourceRef="marquer-debourse" targetRef="fin-ok" />
    <bpmn:sequenceFlow id="Flux_23" sourceRef="fusion-refus" targetRef="marquer-refus" />
    <bpmn:sequenceFlow id="Flux_24" sourceRef="marquer-refus" targetRef="fin-refus" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_debourse">
    <bpmndi:BPMNPlane id="BPMNPlane_debourse" bpmnElement="debourse">
      <bpmndi:BPMNShape id="debut_di" bpmnElement="debut">
