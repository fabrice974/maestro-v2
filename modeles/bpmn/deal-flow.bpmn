      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_15_di" bpmnElement="Flux_15">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1675" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_16_di" bpmnElement="Flux_16">
        <di:waypoint x="1775" y="70" />
        <di:waypoint x="1825" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_17_di" bpmnElement="Flux_17">
        <di:waypoint x="1925" y="70" />
        <di:waypoint x="2000" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_18_di" bpmnElement="Flux_18">
        <di:waypoint x="2050" y="70" />
