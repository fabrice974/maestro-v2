<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_deal-flow" targetNamespace="http://maestro.poc/bpmn" exporter="maestro-generateur" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="deal-flow" name="Deal flow" isExecutable="true">
    <bpmn:documentation>Du stade « à venir » jusqu'au stade « assigné ».</bpmn:documentation>
    <bpmn:startEvent id="debut" name="Occasion à venir">
      <bpmn:outgoing>Flux_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="qualifier" name="Qualifier l&#39;occasion">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.qualifier-occasion&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="qualification" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_1</bpmn:incoming>
      <bpmn:outgoing>Flux_2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="regle-admissibilite" name="Filtrage : admissibilité au mandat">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="admissibilite-mandat" resultVariable="admissibilite" />
        <zeebe:taskHeaders>
          <zeebe:header key="regle" value="admissibilite-mandat" />
          <zeebe:header key="variable" value="admissibilite" />
        </zeebe:taskHeaders>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" retries="3" type="regle.consigner" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_2</bpmn:incoming>
      <bpmn:outgoing>Flux_3</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw-admissible" name="Admissible ?">
      <bpmn:incoming>Flux_3</bpmn:incoming>
      <bpmn:outgoing>Flux_4</bpmn:outgoing>
      <bpmn:outgoing>Flux_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="analyse" name="Analyse préliminaire et mémo">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.analyse-preliminaire&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="analyse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_4</bpmn:incoming>
      <bpmn:outgoing>Flux_6</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-analyse" name="Poursuivre ?">
      <bpmn:incoming>Flux_6</bpmn:incoming>
      <bpmn:outgoing>Flux_7</bpmn:outgoing>
      <bpmn:outgoing>Flux_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="principe" name="Approbation de principe">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.approbation-principe&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="approbationPrincipe" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_7</bpmn:incoming>
      <bpmn:outgoing>Flux_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-principe" name="Approuvé ?">
      <bpmn:incoming>Flux_9</bpmn:incoming>
      <bpmn:outgoing>Flux_10</bpmn:outgoing>
      <bpmn:outgoing>Flux_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="revue" name="Revue diligente">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="revue-diligente" propagateAllChildVariables="true" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_10</bpmn:incoming>
      <bpmn:outgoing>Flux_12</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-revue" name="Recommandation ?">
      <bpmn:incoming>Flux_12</bpmn:incoming>
      <bpmn:outgoing>Flux_13</bpmn:outgoing>
      <bpmn:outgoing>Flux_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="structuration" name="Structuration et négociation">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.structuration&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="structuration" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_13</bpmn:incoming>
      <bpmn:outgoing>Flux_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="regle-approbation" name="Déterminer l&#39;instance d&#39;approbation">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="niveau-approbation" resultVariable="instanceApprobation" />
        <zeebe:ioMapping>
          <zeebe:input source="=structuration.champs.montantEngagement" target="montantDecision" />
          <zeebe:input source="=classeActif" target="classeActif" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="regle" value="niveau-approbation" />
          <zeebe:header key="variable" value="instanceApprobation" />
        </zeebe:taskHeaders>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" retries="3" type="regle.consigner" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_15</bpmn:incoming>
      <bpmn:outgoing>Flux_16</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:callActivity id="finale" name="Approbation finale">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.approbation-finale&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="approbationFinale" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_16</bpmn:incoming>
      <bpmn:outgoing>Flux_17</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-finale" name="Approuvé ?">
      <bpmn:incoming>Flux_17</bpmn:incoming>
      <bpmn:outgoing>Flux_18</bpmn:outgoing>
      <bpmn:outgoing>Flux_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="juridique" name="Documentation juridique et clôture">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.documentation-juridique&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="documentation" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_18</bpmn:incoming>
      <bpmn:outgoing>Flux_20</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="assigner" name="Assigner le mandat">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;dealflow.assigner-mandat&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="mandat" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_20</bpmn:incoming>
      <bpmn:outgoing>Flux_21</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:scriptTask id="marquer-assigne" name="Stade : assigné">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;assigne&#34;" resultVariable="issueDealFlow" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_21</bpmn:incoming>
      <bpmn:outgoing>Flux_22</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="fin-assigne" name="Mandat assigné">
      <bpmn:incoming>Flux_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="fusion-abandon" name="">
      <bpmn:incoming>Flux_5</bpmn:incoming>
      <bpmn:incoming>Flux_8</bpmn:incoming>
      <bpmn:incoming>Flux_11</bpmn:incoming>
      <bpmn:incoming>Flux_14</bpmn:incoming>
      <bpmn:incoming>Flux_19</bpmn:incoming>
      <bpmn:outgoing>Flux_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="marquer-abandon" name="Stade : abandonné">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;abandonne&#34;" resultVariable="issueDealFlow" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_23</bpmn:incoming>
      <bpmn:outgoing>Flux_24</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="fin-abandon" name="Occasion abandonnée">
      <bpmn:incoming>Flux_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1" sourceRef="debut" targetRef="qualifier" />
    <bpmn:sequenceFlow id="Flux_2" sourceRef="qualifier" targetRef="regle-admissibilite" />
    <bpmn:sequenceFlow id="Flux_3" sourceRef="regle-admissibilite" targetRef="gw-admissible" />
    <bpmn:sequenceFlow id="Flux_4" name="oui" sourceRef="gw-admissible" targetRef="analyse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=admissibilite.admissible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_5" name="non" sourceRef="gw-admissible" targetRef="fusion-abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=admissibilite.admissible = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_6" sourceRef="analyse" targetRef="gw-analyse" />
    <bpmn:sequenceFlow id="Flux_7" name="poursuivre" sourceRef="gw-analyse" targetRef="principe">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=analyse.decision = "poursuivre"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_8" name="abandonner" sourceRef="gw-analyse" targetRef="fusion-abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=analyse.decision != "poursuivre"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_9" sourceRef="principe" targetRef="gw-principe" />
    <bpmn:sequenceFlow id="Flux_10" name="approuvé" sourceRef="gw-principe" targetRef="revue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbationPrincipe.decision = "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_11" name="refusé" sourceRef="gw-principe" targetRef="fusion-abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbationPrincipe.decision != "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_12" sourceRef="revue" targetRef="gw-revue" />
    <bpmn:sequenceFlow id="Flux_13" name="favorable" sourceRef="gw-revue" targetRef="structuration">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=synthese.decision != "defavorable"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_14" name="défavorable" sourceRef="gw-revue" targetRef="fusion-abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=synthese.decision = "defavorable"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_15" sourceRef="structuration" targetRef="regle-approbation" />
    <bpmn:sequenceFlow id="Flux_16" sourceRef="regle-approbation" targetRef="finale" />
    <bpmn:sequenceFlow id="Flux_17" sourceRef="finale" targetRef="gw-finale" />
    <bpmn:sequenceFlow id="Flux_18" name="approuvé" sourceRef="gw-finale" targetRef="juridique">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbationFinale.decision = "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_19" name="refusé" sourceRef="gw-finale" targetRef="fusion-abandon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approbationFinale.decision != "approuve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_20" sourceRef="juridique" targetRef="assigner" />
    <bpmn:sequenceFlow id="Flux_21" sourceRef="assigner" targetRef="marquer-assigne" />
    <bpmn:sequenceFlow id="Flux_22" sourceRef="marquer-assigne" targetRef="fin-assigne" />
    <bpmn:sequenceFlow id="Flux_23" sourceRef="fusion-abandon" targetRef="marquer-abandon" />
    <bpmn:sequenceFlow id="Flux_24" sourceRef="marquer-abandon" targetRef="fin-abandon" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_deal-flow">
    <bpmndi:BPMNPlane id="BPMNPlane_deal-flow" bpmnElement="deal-flow">
      <bpmndi:BPMNShape id="debut_di" bpmnElement="debut">
