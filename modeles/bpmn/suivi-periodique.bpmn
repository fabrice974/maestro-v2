<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Defs_suivi-periodique" targetNamespace="http://maestro.poc/bpmn" exporter="maestro-generateur" exporterVersion="1.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:process id="suivi-periodique" name="Suivi périodique (mensuel)" isExecutable="true">
    <bpmn:documentation>Collecte et analyse mensuelles ; sortie par remboursement complet ou décision de désinvestir.</bpmn:documentation>
    <bpmn:startEvent id="debut" name="Post-investissement">
      <bpmn:outgoing>Flux_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="fusion" name="">
      <bpmn:incoming>Flux_1</bpmn:incoming>
      <bpmn:incoming>Flux_8</bpmn:incoming>
      <bpmn:incoming>Flux_11</bpmn:incoming>
      <bpmn:incoming>Flux_14</bpmn:incoming>
      <bpmn:outgoing>Flux_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="attente" name="Attente du prochain cycle">
      <bpmn:incoming>Flux_2</bpmn:incoming>
      <bpmn:outgoing>Flux_3</bpmn:outgoing>
      <bpmn:outgoing>Flux_16</bpmn:outgoing>
      <bpmn:outgoing>Flux_20</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="mois" name="Fin du mois">
      <bpmn:incoming>Flux_3</bpmn:incoming>
      <bpmn:outgoing>Flux_4</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=delaiSuivi</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="rembourse" name="Remboursement complet">
      <bpmn:incoming>Flux_20</bpmn:incoming>
      <bpmn:outgoing>Flux_21</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_remboursement_complet" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="desinvestir-demande" name="Décision de désinvestir">
      <bpmn:incoming>Flux_16</bpmn:incoming>
      <bpmn:outgoing>Flux_17</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_decision_desinvestir" />
    </bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="collecte" name="Collecte mensuelle">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;suivi.collecte-mensuelle&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="collecte" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_4</bpmn:incoming>
      <bpmn:outgoing>Flux_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:businessRuleTask id="regle-covenants" name="Analyser les clauses financières">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="alerte-covenants" resultVariable="statutCovenants" />
        <zeebe:ioMapping>
          <zeebe:input source="=collecte.champs.detteNette / collecte.champs.baiia" target="ratioLevier" />
          <zeebe:input source="=collecte.champs.fluxDisponibles / collecte.champs.serviceDette" target="ratioCouverture" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="regle" value="alerte-covenants" />
          <zeebe:header key="variable" value="statutCovenants" />
        </zeebe:taskHeaders>
        <zeebe:executionListeners>
          <zeebe:executionListener eventType="end" retries="3" type="regle.consigner" />
        </zeebe:executionListeners>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_5</bpmn:incoming>
      <bpmn:outgoing>Flux_6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:scriptTask id="surveillance" name="Mettre à jour la surveillance">
      <bpmn:extensionElements>
        <zeebe:script expression="={moisConformes: if statutCovenants = &#34;conforme&#34; then (if surveillance = null then 1 else surveillance.moisConformes + 1) else 0, active: statutCovenants != &#34;conforme&#34; or (surveillance != null and surveillance.active and moisConformes &#60; 2)}" resultVariable="surveillance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_6</bpmn:incoming>
      <bpmn:outgoing>Flux_7</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="gw-statut" name="Statut des clauses ?">
      <bpmn:incoming>Flux_7</bpmn:incoming>
      <bpmn:outgoing>Flux_8</bpmn:outgoing>
      <bpmn:outgoing>Flux_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="plan" name="Plan d&#39;action">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;suivi.plan-action&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="planAction" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_9</bpmn:incoming>
      <bpmn:outgoing>Flux_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-bris" name="Bris ?">
      <bpmn:incoming>Flux_10</bpmn:incoming>
      <bpmn:outgoing>Flux_11</bpmn:outgoing>
      <bpmn:outgoing>Flux_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="decision" name="Décision de maintien ou de sortie">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="tache-metier" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=&#34;suivi.decision-maintien&#34;" target="typeTache" />
          <zeebe:output source="=resultat" target="decisionMaintien" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_12</bpmn:incoming>
      <bpmn:outgoing>Flux_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-decision" name="Décision ?">
      <bpmn:incoming>Flux_13</bpmn:incoming>
      <bpmn:outgoing>Flux_14</bpmn:outgoing>
      <bpmn:outgoing>Flux_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="fusion-sortie" name="">
      <bpmn:incoming>Flux_15</bpmn:incoming>
      <bpmn:incoming>Flux_17</bpmn:incoming>
      <bpmn:outgoing>Flux_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="marquer-desinvestir" name="Sortie : désinvestir">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;desinvestir&#34;" resultVariable="issueSuivi" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_18</bpmn:incoming>
      <bpmn:outgoing>Flux_19</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="fin-desinvestir" name="Désinvestissement requis">
      <bpmn:incoming>Flux_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="marquer-rembourse" name="Sortie : remboursé">
      <bpmn:extensionElements>
        <zeebe:script expression="=&#34;rembourse&#34;" resultVariable="issueSuivi" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flux_21</bpmn:incoming>
      <bpmn:outgoing>Flux_22</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="fin-rembourse" name="Remboursé en totalité">
      <bpmn:incoming>Flux_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flux_1" sourceRef="debut" targetRef="fusion" />
    <bpmn:sequenceFlow id="Flux_2" sourceRef="fusion" targetRef="attente" />
    <bpmn:sequenceFlow id="Flux_3" sourceRef="attente" targetRef="mois" />
    <bpmn:sequenceFlow id="Flux_4" sourceRef="mois" targetRef="collecte" />
    <bpmn:sequenceFlow id="Flux_5" sourceRef="collecte" targetRef="regle-covenants" />
    <bpmn:sequenceFlow id="Flux_6" sourceRef="regle-covenants" targetRef="surveillance" />
    <bpmn:sequenceFlow id="Flux_7" sourceRef="surveillance" targetRef="gw-statut" />
    <bpmn:sequenceFlow id="Flux_8" name="conforme" sourceRef="gw-statut" targetRef="fusion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=statutCovenants = "conforme"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_9" name="surveillance / bris" sourceRef="gw-statut" targetRef="plan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=statutCovenants != "conforme"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_10" sourceRef="plan" targetRef="gw-bris" />
    <bpmn:sequenceFlow id="Flux_11" name="surveillance" sourceRef="gw-bris" targetRef="fusion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=statutCovenants = "surveillance"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_12" name="bris" sourceRef="gw-bris" targetRef="decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=statutCovenants = "bris"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_13" sourceRef="decision" targetRef="gw-decision" />
    <bpmn:sequenceFlow id="Flux_14" name="garder" sourceRef="gw-decision" targetRef="fusion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionMaintien.decision = "garder"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_15" name="désinvestir" sourceRef="gw-decision" targetRef="fusion-sortie">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=decisionMaintien.decision = "desinvestir"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flux_16" sourceRef="attente" targetRef="desinvestir-demande" />
    <bpmn:sequenceFlow id="Flux_17" sourceRef="desinvestir-demande" targetRef="fusion-sortie" />
    <bpmn:sequenceFlow id="Flux_18" sourceRef="fusion-sortie" targetRef="marquer-desinvestir" />
    <bpmn:sequenceFlow id="Flux_19" sourceRef="marquer-desinvestir" targetRef="fin-desinvestir" />
    <bpmn:sequenceFlow id="Flux_20" sourceRef="attente" targetRef="rembourse" />
    <bpmn:sequenceFlow id="Flux_21" sourceRef="rembourse" targetRef="marquer-rembourse" />
    <bpmn:sequenceFlow id="Flux_22" sourceRef="marquer-rembourse" targetRef="fin-rembourse" />
  </bpmn:process>
  <bpmn:message id="Msg_remboursement_complet" name="remboursement-complet">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=dossierId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Msg_decision_desinvestir" name="decision-desinvestir">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=dossierId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_suivi-periodique">
    <bpmndi:BPMNPlane id="BPMNPlane_suivi-periodique" bpmnElement="suivi-periodique">
      <bpmndi:BPMNShape id="debut_di" bpmnElement="debut">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fusion_di" bpmnElement="fusion" isMarkerVisible="true">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="attente_di" bpmnElement="attente">
        <dc:Bounds x="350" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mois_di" bpmnElement="mois">
        <dc:Bounds x="507" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="collecte_di" bpmnElement="collecte">
        <dc:Bounds x="625" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="regle-covenants_di" bpmnElement="regle-covenants">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="surveillance_di" bpmnElement="surveillance">
        <dc:Bounds x="925" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-statut_di" bpmnElement="gw-statut" isMarkerVisible="true">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="plan_di" bpmnElement="plan">
        <dc:Bounds x="1225" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-bris_di" bpmnElement="gw-bris" isMarkerVisible="true">
        <dc:Bounds x="1400" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="decision_di" bpmnElement="decision">
        <dc:Bounds x="1525" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw-decision_di" bpmnElement="gw-decision" isMarkerVisible="true">
        <dc:Bounds x="1700" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fusion-sortie_di" bpmnElement="fusion-sortie" isMarkerVisible="true">
        <dc:Bounds x="1850" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="marquer-desinvestir_di" bpmnElement="marquer-desinvestir">
        <dc:Bounds x="1975" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin-desinvestir_di" bpmnElement="fin-desinvestir">
        <dc:Bounds x="2157" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="desinvestir-demande_di" bpmnElement="desinvestir-demande">
        <dc:Bounds x="507" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rembourse_di" bpmnElement="rembourse">
        <dc:Bounds x="507" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="marquer-rembourse_di" bpmnElement="marquer-rembourse">
        <dc:Bounds x="625" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin-rembourse_di" bpmnElement="fin-rembourse">
        <dc:Bounds x="807" y="332" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flux_1_di" bpmnElement="Flux_1">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="200" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_2_di" bpmnElement="Flux_2">
        <di:waypoint x="250" y="70" />
        <di:waypoint x="350" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_3_di" bpmnElement="Flux_3">
        <di:waypoint x="400" y="70" />
        <di:waypoint x="507" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_16_di" bpmnElement="Flux_16">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="210" />
        <di:waypoint x="507" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_20_di" bpmnElement="Flux_20">
        <di:waypoint x="375" y="95" />
        <di:waypoint x="375" y="350" />
        <di:waypoint x="507" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_4_di" bpmnElement="Flux_4">
        <di:waypoint x="543" y="70" />
        <di:waypoint x="625" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_5_di" bpmnElement="Flux_5">
        <di:waypoint x="725" y="70" />
        <di:waypoint x="775" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_6_di" bpmnElement="Flux_6">
        <di:waypoint x="875" y="70" />
        <di:waypoint x="925" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_7_di" bpmnElement="Flux_7">
        <di:waypoint x="1025" y="70" />
        <di:waypoint x="1100" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_8_di" bpmnElement="Flux_8">
        <di:waypoint x="1125" y="95" />
        <di:waypoint x="1125" y="140" />
        <di:waypoint x="225" y="140" />
        <di:waypoint x="225" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_9_di" bpmnElement="Flux_9">
        <di:waypoint x="1150" y="70" />
        <di:waypoint x="1225" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_10_di" bpmnElement="Flux_10">
        <di:waypoint x="1325" y="70" />
        <di:waypoint x="1400" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_11_di" bpmnElement="Flux_11">
        <di:waypoint x="1425" y="95" />
        <di:waypoint x="1425" y="140" />
        <di:waypoint x="225" y="140" />
        <di:waypoint x="225" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_12_di" bpmnElement="Flux_12">
        <di:waypoint x="1450" y="70" />
        <di:waypoint x="1525" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_13_di" bpmnElement="Flux_13">
        <di:waypoint x="1625" y="70" />
        <di:waypoint x="1700" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_14_di" bpmnElement="Flux_14">
        <di:waypoint x="1725" y="95" />
        <di:waypoint x="1725" y="140" />
        <di:waypoint x="225" y="140" />
        <di:waypoint x="225" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_15_di" bpmnElement="Flux_15">
        <di:waypoint x="1750" y="70" />
        <di:waypoint x="1850" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_18_di" bpmnElement="Flux_18">
        <di:waypoint x="1900" y="70" />
        <di:waypoint x="1975" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_19_di" bpmnElement="Flux_19">
        <di:waypoint x="2075" y="70" />
        <di:waypoint x="2157" y="70" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_17_di" bpmnElement="Flux_17">
        <di:waypoint x="543" y="210" />
        <di:waypoint x="1875" y="210" />
        <di:waypoint x="1875" y="95" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_21_di" bpmnElement="Flux_21">
        <di:waypoint x="543" y="350" />
        <di:waypoint x="625" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flux_22_di" bpmnElement="Flux_22">
        <di:waypoint x="725" y="350" />
        <di:waypoint x="807" y="350" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
